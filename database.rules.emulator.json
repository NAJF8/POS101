{
  "rules": {
    ".read": false,
    ".write": false,
    "pos101_authorized_uids": {
      ".read": false,
      ".write": false
    },
    "pos101_sales": {
      ".read": "auth != null && root.child('pos101_authorized_uids').child(auth.uid).child('read').val() === true",
      "$saleId": {
        ".write": "auth != null && root.child('pos101_authorized_uids').child(auth.uid).child('write').val() === true && newData.exists() && newData.child('saleId').val() === $saleId",
        ".validate": "newData.hasChildren(['saleId', 'createdAt', 'orderNumber', 'total'])"
      }
    },
    "pos101_products": {
      ".read": "auth != null && (auth.uid === '4Tx0bMygd8gVuDDDOblnt3HOvo72' || auth.uid === 'rtDA9erW11geHfLpa3ZW3LacZR73')",
      ".write": "auth != null && auth.uid === 'rtDA9erW11geHfLpa3ZW3LacZR73'",
      "$productId": {
        ".validate": "newData.hasChildren(['id', 'name', 'price', 'enabled']) && newData.child('id').val() === $productId && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('price').isNumber() && newData.child('price').val() >= 0 && newData.child('enabled').isBoolean()"
      }
    }
  }
}
